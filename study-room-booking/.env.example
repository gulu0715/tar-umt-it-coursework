# Copy to .env for local development. Never commit .env.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=study_room_booking_db

# Set to true only when the application is served over HTTPS (for example, via an AWS ALB).
SESSION_SECURE_COOKIE=false

# Optional shared room-image storage for EC2/ASG. Prefer an EC2 IAM role where the environment allows it.
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
